        function loadUserTable() {
            const tbody = document.getElementById('userTable');
            tbody.innerHTML = '';
            users.filter(u => u.role !== 'admin').forEach(user => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td class="px-4 py-2">${user.username}</td>
                    <td class="px-4 py-2">${user.fullName}</td>
                    <td class="px-4 py-2">${user.role === 'student' ? 'Siswa' : 'Wali Kelas'}</td>
                    <td class="px-4 py-2">Kelas ${user.class}</td>
                    <td class="px-4 py-2">
                        <button onclick="editUser('${user.username}')" class="bg-yellow-500 text-white px-2 py-1 rounded mr-2 hover:bg-yellow-600">Edit</button>
                        <button onclick="deleteUser('${user.username}')" class="bg-red-500 text-white px-2 py-1 rounded hover:bg-red-600">Hapus</button>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        // --- User management (Add/Edit/Delete) is kept as is ---
        function showAddUserModal() {
            document.getElementById('addUserModal').classList.remove('hidden');
        }

        function hideAddUserModal() {
            document.getElementById('addUserModal').classList.add('hidden');
            document.getElementById('addUserForm').reset();
        }

        document.getElementById('addUserForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const username = document.getElementById('newUsername').value;
            const password = document.getElementById('newPassword').value;
            const fullName = document.getElementById('newFullName').value;
            const role = document.getElementById('newRole').value;
            const userClass = document.getElementById('newClass').value;

            if (users.find(u => u.username === username)) {
                alert('Username sudah ada!');
                return;
            }

            users.push({
                username,
                password,
                fullName,
                role,
                class: userClass
            });
            localStorage.setItem('users', JSON.stringify(users));
            loadUserTable();
            updateUserStats();
            hideAddUserModal();
            alert('Pengguna berhasil ditambahkan!');
        });

        document.getElementById('editUserForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const originalUsername = document.getElementById('editOriginalUsername').value;
            const username = document.getElementById('editUsername').value;
            const password = document.getElementById('editPassword').value;
            const fullName = document.getElementById('editFullName').value;
            const role = document.getElementById('editRole').value;
            const userClass = document.getElementById('editClass').value;

            // Check if new username already exists (but not the original one)
            if (username !== originalUsername && users.find(u => u.username === username)) {
                alert('Username sudah ada!');
                return;
            }

            // Find and update the user
            const userIndex = users.findIndex(u => u.username === originalUsername);
            if (userIndex !== -1) {
                users[userIndex] = {
                    username,
                    password,
                    fullName,
                    role,
                    class: userClass
                };

                // Update journals if username changed
                if (username !== originalUsername) {
                    journals.forEach(journal => {
                        if (journal.username === originalUsername) {
                            journal.username = username;
                        }
                    });
                }

                localStorage.setItem('users', JSON.stringify(users));
                localStorage.setItem('journals', JSON.stringify(journals));
                backToAdminDashboard();
                loadUserTable();
                updateUserStats();
                alert('Pengguna berhasil diperbarui!');
            }
        });

        function editUser(username) {
            const user = users.find(u => u.username === username);
            if (user) {
                // Hide admin dashboard and show edit screen
                document.getElementById('adminDashboard').classList.add('hidden');
                document.getElementById('editUserScreen').classList.remove('hidden');

                // Populate edit form
                document.getElementById('editOriginalUsername').value = user.username;
                document.getElementById('editUsername').value = user.username;
                document.getElementById('editPassword').value = user.password;
                document.getElementById('editFullName').value = user.fullName;
                document.getElementById('editRole').value = user.role;
                document.getElementById('editClass').value = user.class;
            }
        }

        function deleteUser(username) {
            if (confirm(`Yakin ingin menghapus pengguna ${username}? Tindakan ini tidak dapat dibatalkan.`)) {
                // Remove user
                users = users.filter(u => u.username !== username);
                
                // Remove their journals
                journals = journals.filter(j => j.username !== username);

                localStorage.setItem('users', JSON.stringify(users));
                localStorage.setItem('journals', JSON.stringify(journals));

                loadUserTable();
                updateUserStats();
                alert('Pengguna berhasil dihapus!');
            }
        }

