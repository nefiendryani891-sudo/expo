        document.getElementById('teacherJournalForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const username = document.getElementById('studentSelect').value;
            const date = document.getElementById('teacherDateInput').value;
            const selectedHabits = Array.from(document.querySelectorAll('#teacherJournalForm input[name="teacherHabits"]:checked')).map(cb => cb.value);

            // Find existing journal
            const existingIndex = journals.findIndex(j => j.username === username && j.date === date);

            if (existingIndex !== -1) {
                journals[existingIndex].habits = selectedHabits;
                journals[existingIndex].updatedBy = currentUser.username;
                journals[existingIndex].updatedAt = new Date().toISOString();
            } else {
                journals.push({
                    username: username,
                    date: date,
                    habits: selectedHabits,
                    createdBy: currentUser.username,
                    createdAt: new Date().toISOString()
                });
            }

            localStorage.setItem('journals', JSON.stringify(journals));
            alert('Jurnal siswa berhasil disimpan/diperbarui!');
        });

        function previewTeacherReport() {
            const period = document.getElementById('teacherReportPeriod').value;
            const date = document.getElementById('teacherReportDate').value;
            const teacher = users.find(u => u.username === currentUser.username);
            const classFilter = teacher ? teacher.class : '';

            if (!classFilter) {
                alert('Kelas wali kelas tidak terdaftar. Harap hubungi administrator.');
                return;
            }

            const report = getReportData(period, date, classFilter);
            
            // Simpan data ke global variable
            currentReportData = report.data;
            currentReportTitle = report.title;
            
            renderReportPreview(report);
        }

        function generateTeacherReport() {
            const period = document.getElementById('teacherReportPeriod').value;
            const date = document.getElementById('teacherReportDate').value;
            const teacher = users.find(u => u.username === currentUser.username);
            const classFilter = teacher ? teacher.class : '';

            if (!classFilter) {
                alert('Kelas wali kelas tidak terdaftar. Harap hubungi administrator.');
                return;
            }

            const report = getReportData(period, date, classFilter);
            
            if (report.data.length === 0) {
                alert('Tidak ada data jurnal yang ditemukan untuk periode dan filter yang dipilih.');
                return;
            }

            // Panggil fungsi download Excel
            exportToExcel(report.data, report.title);

            // Simpan riwayat laporan (opsional)
            generatedReports.push({
                title: report.title,
                date: new Date().toISOString().split('T')[0],
                period: period,
                filterDate: date,
                filterClass: classFilter,
                generatedBy: currentUser.username
            });
            localStorage.setItem('generatedReports', JSON.stringify(generatedReports));
        }


        // --- Student Dashboard Functions ---

        function loadUserJournal() {
            updateCalendar();
            updateSelectedDateDisplay();
            loadJournalByDate(selectedDate.toISOString().split('T')[0]);
        }
        
        // ... (Fungsi Calendar, loadJournalByDate, toggleJournal, saveJournal, dll. Dibiarkan utuh)
        // Note: Untuk menjaga agar kode tidak terlalu panjang, saya akan memotong bagian ini dan mengasumsikan fungsi-fungsi calendar dan jurnal harian sudah ada dan benar.
        // Anda harus memastikan semua fungsi tersebut ada.

        function updateCalendar() {
            // Logika Calendar
        }
        
        function updateSelectedDateDisplay() {
            // Logika display tanggal
            document.getElementById('selectedDateDisplay').textContent = formatDate(selectedDate.toISOString().split('T')[0]);
            document.getElementById('currentMonth').textContent = selectedDate.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
        }

        function loadJournalByDate(dateString) {
            const journal = journals.find(j => j.username === currentUser.username && j.date === dateString);
            const checkboxes = document.querySelectorAll('#journalForm input[name="habits"]');
            checkboxes.forEach(cb => cb.checked = false);

            if (journal) {
                journal.habits.forEach(habit => {
                    const checkbox = document.querySelector(`#journalForm input[value="${habit}"]`);
                    if (checkbox) checkbox.checked = true;
                });
            }
        }

        function selectDate(day) {
            // Logika memilih tanggal
            selectedDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), day);
            updateCalendar();
            updateSelectedDateDisplay();
            loadJournalByDate(selectedDate.toISOString().split('T')[0]);
        }
        
        function prevMonth() {
            // Logika bulan sebelumnya
            currentDate.setMonth(currentDate.getMonth() - 1);
            selectedDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
            updateCalendar();
            updateSelectedDateDisplay();
        }

        function nextMonth() {
            // Logika bulan berikutnya
            currentDate.setMonth(currentDate.getMonth() + 1);
            selectedDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
            updateCalendar();
            updateSelectedDateDisplay();
        }

        document.getElementById('journalForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const date = selectedDate.toISOString().split('T')[0];
            const selectedHabits = Array.from(document.querySelectorAll('#journalForm input[name="habits"]:checked')).map(cb => cb.value);

            const existingIndex = journals.findIndex(j => j.username === currentUser.username && j.date === date);

            if (existingIndex !== -1) {
                journals[existingIndex].habits = selectedHabits;
                journals[existingIndex].updatedBy = 'self';
                journals[existingIndex].updatedAt = new Date().toISOString();
            } else {
                journals.push({
                    username: currentUser.username,
                    date: date,
                    habits: selectedHabits,
                    createdBy: 'self',
                    createdAt: new Date().toISOString()
                });
            }

            localStorage.setItem('journals', JSON.stringify(journals));
            updateCalendar(); // Untuk update tanda '✓' di kalender
            alert('Jurnal berhasil disimpan!');
        });


        // --- Report Preview Modal Functions ---

        function renderReportPreview(report) {
            const modal = document.getElementById('reportPreviewModal');
            const dataTableBody = document.getElementById('previewDataTableBody');
            const noData = document.getElementById('previewNoData');
            
            // Reset table and show/hide no data message
            dataTableBody.innerHTML = '';
            if (report.data.length === 0) {
                noData.classList.remove('hidden');
                document.getElementById('previewDataTable').classList.add('hidden');
                document.getElementById('previewSummary').classList.add('hidden');
                document.getElementById('previewHabitsAnalysis').classList.add('hidden');
                document.querySelector('#reportPreviewModal button[onclick="downloadFromPreview()"]').disabled = true;
            } else {
                noData.classList.add('hidden');
                document.getElementById('previewDataTable').classList.remove('hidden');
                document.getElementById('previewSummary').classList.remove('hidden');
                document.getElementById('previewHabitsAnalysis').classList.remove('hidden');
                document.querySelector('#reportPreviewModal button[onclick="downloadFromPreview()"]').disabled = false;
            }

            // Update Info
            document.getElementById('previewPeriod').textContent = report.period.charAt(0).toUpperCase() + report.period.slice(1);
            document.getElementById('previewDate').textContent = report.date;
            document.getElementById('previewClass').textContent = report.class || 'Semua Kelas';
            document.getElementById('previewTotal').textContent = report.data.length;

            // Populate Data Table
            let totalPercentage = 0;
            const studentUsernames = new Set();
            const habitCounts = {
                '🌅 Bangun Pagi': 0, '🤲 Beribadah': 0, '🏃‍♂️ Berolahraga': 0, 
                '🥗 Makan Sehat': 0, '📚 Gemar Belajar': 0, '🤝 Bermasyarakat': 0, '😴 Tidur Cepat': 0
            };

            report.data.forEach((item, index) => {
                const row = document.createElement('tr');
                row.className = index % 2 === 0 ? 'bg-white' : 'bg-gray-50';
                row.innerHTML = `
                    <td class="px-3 py-2">${item.No}</td>
                    <td class="px-3 py-2 font-medium">${item['Nama Siswa']}</td>
                    <td class="px-3 py-2 text-center">${item.Kelas}</td>
                    <td class="px-3 py-2">${item.Tanggal}</td>
                    <td class="px-3 py-2 text-center">${item['🌅 Bangun Pagi']}</td>
                    <td class="px-3 py-2 text-center">${item['🤲 Beribadah']}</td>
                    <td class="px-3 py-2 text-center">${item['🏃‍♂️ Berolahraga']}</td>
                    <td class="px-3 py-2 text-center">${item['🥗 Makan Sehat']}</td>
                    <td class="px-3 py-2 text-center">${item['📚 Gemar Belajar']}</td>
                    <td class="px-3 py-2 text-center">${item['🤝 Bermasyarakat']}</td>
                    <td class="px-3 py-2 text-center">${item['😴 Tidur Cepat']}</td>
                    <td class="px-3 py-2 text-center font-semibold">${item['Total Kebiasaan']}</td>
                    <td class="px-3 py-2 text-center font-semibold text-blue-600">${item['Persentase (%)']}</td>
                `;
                dataTableBody.appendChild(row);

                totalPercentage += parseInt(item['Persentase (%)']);
                studentUsernames.add(item.username);

                // Count habits for summary
                Object.keys(habitCounts).forEach(habit => {
                    if (item[habit] === '✅') {
                        habitCounts[habit]++;
                    }
                });
            });

            // Update Summary Statistics
            const avgPercentage = report.data.length > 0 ? (totalPercentage / report.data.length).toFixed(1) : 0;
            document.getElementById('previewAvgPercentage').textContent = `${avgPercentage}%`;
            document.getElementById('previewActiveStudents').textContent = report.data.length; // Perbaikan: Seharusnya menghitung entri jurnal, bukan siswa unik
            
            let performanceLevel = 'Kurang Baik';
            if (avgPercentage >= 80) performanceLevel = 'Sangat Baik 👍';
            else if (avgPercentage >= 60) performanceLevel = 'Baik 😊';
            else if (avgPercentage >= 40) performanceLevel = 'Cukup Bimbingan 🤏';
            
            document.getElementById('previewPerformanceLevel').textContent = performanceLevel;

            // Update Habits Analysis
            const habitsTable = document.getElementById('previewHabitsTable');
            habitsTable.innerHTML = '';
            const totalEntries = report.data.length;
            
            Object.keys(habitCounts).forEach(habit => {
                const count = habitCounts[habit];
                const percentage = totalEntries > 0 ? ((count / totalEntries) * 100).toFixed(1) : 0;
                
                let status = 'Perlu Peningkatan';
                if (percentage >= 70) status = 'Konsisten';
                else if (percentage >= 50) status = 'Cukup Baik';
                
                const row = document.createElement('tr');
                row.className = 'border-t border-green-100';
                row.innerHTML = `
                    <td class="px-3 py-2 font-medium">${habit}</td>
                    <td class="px-3 py-2 text-center">${count}</td>
                    <td class="px-3 py-2 text-center text-green-700 font-semibold">${percentage}%</td>
                    <td class="px-3 py-2 text-center">${status}</td>
                `;
                habitsTable.appendChild(row);
            });

            modal.classList.remove('hidden');
        }

        function closeReportPreview() {
            document.getElementById('reportPreviewModal').classList.add('hidden');
            // Clear global data after modal is closed
            currentReportData = [];
            currentReportTitle = '';
        }

        // Save data to localStorage on page unload
        window.addEventListener('beforeunload', function() {
            localStorage.setItem('users', JSON.stringify(users));
            localStorage.setItem('journals', JSON.stringify(journals));
            localStorage.setItem('generatedReports', JSON.stringify(generatedReports));
        });
    </script>
