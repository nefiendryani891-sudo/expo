    <script>
        // Global variables
        let currentUser = null;
        let users = JSON.parse(localStorage.getItem('users')) || [
            { username: 'admin', password: 'admin123456', role: 'admin', fullName: 'Administrator', class: null }
        ];
        let journals = JSON.parse(localStorage.getItem('journals')) || [];
        let generatedReports = JSON.parse(localStorage.getItem('generatedReports')) || [];
        
        // Variabel Global untuk menyimpan data laporan yang sedang di-preview/dibuat
        let currentReportData = [];
        let currentReportTitle = '';

        let currentDate = new Date();
        let selectedDate = new Date();

        // Initialize app
        document.addEventListener('DOMContentLoaded', function() {
            updateCalendar();
            updateSelectedDateDisplay();
        });

        // --- Helper Functions ---
        
        // Fungsi baru untuk mengubah data array ke Excel dan mendownloadnya
        function exportToExcel(data, title) {
            if (data.length === 0) {
                alert('Tidak ada data untuk di-download!');
                return;
            }

            // 1. Ubah data laporan (array of objects) menjadi format worksheet
            // Tambahkan baris header secara otomatis
            const ws = XLSX.utils.json_to_sheet(data); 

            // 2. Buat workbook baru
            const wb = XLSX.utils.book_new();

            // 3. Masukkan worksheet ke dalam workbook
            XLSX.utils.book_append_sheet(wb, ws, "Data Jurnal");

            // 4. Tentukan nama file
            const dateStr = new Date().toISOString().split('T')[0];
            const safeTitle = title.replace(/[^a-zA-Z0-9]/g, '_');
            const filename = `${safeTitle}_${dateStr}.xlsx`;

            // 5. Download file ke perangkat pengguna (baris kunci)
            XLSX.writeFile(wb, filename);
            
            alert(`Laporan Excel "${filename}" berhasil di-download!`);
        }

        // Fungsi untuk mendapatkan nama kebiasaan yang lebih mudah dibaca
        function getHabitName(key) {
            const names = {
                'bangun_pagi': '🌅 Bangun Pagi',
                'beribadah': '🤲 Beribadah',
                'berolahraga': '🏃‍♂️ Berolahraga',
                'makan_sehat': '🥗 Makan Sehat',
                'gemar_belajar': '📚 Gemar Belajar',
                'bermasyarakat': '🤝 Bermasyarakat',
                'tidur_cepat': '😴 Tidur Cepat'
            };
            return names[key] || key;
        }

        // Fungsi untuk memformat tanggal
        function formatDate(dateString) {
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            return new Date(dateString).toLocaleDateString('id-ID', options);
        }

        // Fungsi untuk mendapatkan data laporan berdasarkan filter
        function getReportData(period, dateString, classFilter, teacherUsername = null) {
            let filteredJournals = journals;
            let reportTitle = "Laporan Jurnal Admin";
            
            const date = dateString ? new Date(dateString) : new Date();
            const dateStr = date.toISOString().split('T')[0];
            
            // 1. Filter Tanggal
            filteredJournals = filteredJournals.filter(j => {
                const journalDate = new Date(j.date);
                switch (period) {
                    case 'daily':
                        return j.date === dateStr;
                    case 'weekly':
                        // Logika sederhana: filter berdasarkan minggu yang sama
                        const startOfWeek = new Date(date);
                        startOfWeek.setDate(date.getDate() - date.getDay());
                        const endOfWeek = new Date(startOfWeek);
                        endOfWeek.setDate(startOfWeek.getDate() + 6);
                        return journalDate >= startOfWeek && journalDate <= endOfWeek;
                    case 'monthly':
                        return journalDate.getMonth() === date.getMonth() && journalDate.getFullYear() === date.getFullYear();
                    case 'yearly':
                        return journalDate.getFullYear() === date.getFullYear();
                    default:
                        return true;
                }
            });

            // 2. Filter Kelas
            if (classFilter) {
                const studentsInClass = users.filter(u => u.role === 'student' && u.class === classFilter).map(u => u.username);
                filteredJournals = filteredJournals.filter(j => studentsInClass.includes(j.username));
                reportTitle += ` - Kelas ${classFilter}`;
            }

            // 3. Gabungkan dan Format Data
            const reportData = filteredJournals.map(journal => {
                const user = users.find(u => u.username === journal.username);
                const habitKeys = ['bangun_pagi', 'beribadah', 'berolahraga', 'makan_sehat', 'gemar_belajar', 'bermasyarakat', 'tidur_cepat'];
                
                const totalHabits = 7;
                const achievedHabits = journal.habits.length;
                const percentage = ((achievedHabits / totalHabits) * 100).toFixed(0);

                const data = {
                    No: 0, // Akan diisi saat generate tabel
                    'Nama Siswa': user ? user.fullName : 'Siswa Dihapus',
                    Kelas: user ? user.class : '-',
                    Tanggal: journal.date,
                    '🌅 Bangun Pagi': journal.habits.includes('bangun_pagi') ? '✅' : '❌',
                    '🤲 Beribadah': journal.habits.includes('beribadah') ? '✅' : '❌',
                    '🏃‍♂️ Berolahraga': journal.habits.includes('berolahraga') ? '✅' : '❌',
                    '🥗 Makan Sehat': journal.habits.includes('makan_sehat') ? '✅' : '❌',
                    '📚 Gemar Belajar': journal.habits.includes('gemar_belajar') ? '✅' : '❌',
                    '🤝 Bermasyarakat': journal.habits.includes('bermasyarakat') ? '✅' : '❌',
                    '😴 Tidur Cepat': journal.habits.includes('tidur_cepat') ? '✅' : '❌',
                    'Total Kebiasaan': achievedHabits,
                    'Persentase (%)': percentage + '%',
                };
                return data;
            });

            reportData.forEach((data, index) => data.No = index + 1);

            return { data: reportData, title: reportTitle, class: classFilter, date: dateStr, period: period };
        }

