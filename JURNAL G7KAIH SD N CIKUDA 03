        // --- Report Generation Functions (Admin) ---

        // Fungsi yang dipanggil oleh tombol "Preview Laporan"
        function previewReport() {
            const period = document.getElementById('reportPeriod').value;
            const date = document.getElementById('reportDate').value;
            const classFilter = document.getElementById('reportClass').value;

            const report = getReportData(period, date, classFilter);
            
            // Simpan data ke global variable
            currentReportData = report.data;
            currentReportTitle = report.title;
            
            renderReportPreview(report);
        }

        // Fungsi yang dipanggil oleh tombol "Generate & Download Excel"
        function generateReport() {
            const period = document.getElementById('reportPeriod').value;
            const date = document.getElementById('reportDate').value;
            const classFilter = document.getElementById('reportClass').value;

            const report = getReportData(period, date, classFilter);
            
            if (report.data.length === 0) {
                alert('Tidak ada data jurnal yang ditemukan untuk periode dan filter yang dipilih.');
                return;
            }

            // Panggil fungsi download Excel
            exportToExcel(report.data, report.title);

            // Simpan riwayat laporan
            generatedReports.push({
                title: report.title,
                date: new Date().toISOString().split('T')[0],
                period: period,
                filterDate: date,
                filterClass: classFilter
            });
            localStorage.setItem('generatedReports', JSON.stringify(generatedReports));
            loadGeneratedReportsList();
        }
        
        // Fungsi yang dipanggil oleh tombol "Download Excel" di modal preview
        function downloadFromPreview() {
            // Menggunakan data yang sudah tersimpan di global variable
            exportToExcel(currentReportData, currentReportTitle);
            
            // Simpan riwayat laporan (gunakan variabel dari generateReport jika dipanggil dari generate, atau tambahkan logika baru di sini jika hanya di-download dari preview)
            // Untuk menyederhanakan, kita asumsikan jika download dari preview, ini hanya unduhan tanpa mencatat sebagai "laporan yang dibuat".
            // Jika Anda ingin mencatatnya, Anda harus menyimpan detail filter (period, date, classFilter) di variabel global juga.
