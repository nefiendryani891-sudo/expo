<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jurnal 7 Kebiasaan Anak Indonesia Hebat</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <style>
        body {
            box-sizing: border-box;
        }
        .habit-card {
            transition: all 0.3s ease;
        }
        .habit-card:hover {
            transform: translateY(-2px);
        }
        .calendar-day {
            transition: all 0.2s ease;
            background-color: #f9fafb;
            border: 1px solid #e5e7eb;
        }
        .calendar-day:hover {
            background-color: #dbeafe;
            color: #1e40af;
            border-color: #3b82f6;
        }
        .selected-date {
            background-color: #1d4ed8 !important;
            color: white !important;
            border-color: #1d4ed8 !important;
            font-weight: bold !important;
            box-shadow: 0 0 0 2px rgba(29, 78, 216, 0.2) !important;
        }
        .has-journal {
            background-color: #8b5cf6 !important;
            color: white !important;
            border-color: #8b5cf6 !important;
            font-weight: bold !important;
            position: relative;
        }
        .has-journal:hover {
            background-color: #7c3aed !important;
            color: white !important;
        }
        .has-journal::after {
            content: '✓';
            position: absolute;
            top: 2px;
            right: 4px;
            font-size: 10px;
            font-weight: bold;
        }
        .selected-date.has-journal {
            background-color: #1d4ed8 !important;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.4) !important;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen">

    <div id="loginScreen" class="min-h-screen flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl p-8 w-full max-w-md">
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-indigo-600 mb-2"> 📚 Jurnal 7 Kebiasaan</h1>
                <p class="text-gray-600">Anak Indonesia Hebat</p>
            </div>
            <form id="loginForm" class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Username</label>
                    <input type="text" id="username" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" required>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                    <div class="relative">
                        <input type="password" id="password" class="w-full px-4 py-3 pr-12 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" required>
                        <button type="button" onclick="togglePassword('password')" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700">
                            <span id="passwordToggleIcon"> 👁️ </span>
                        </button>
                    </div>
                </div>
                <button type="submit" class="w-full bg-indigo-600 text-white py-3 rounded-lg hover:bg-indigo-700 transition duration-200 font-medium">
                    Masuk
                </button>
            </form>
        </div>
    </div>

    <div id="adminDashboard" class="hidden min-h-screen">
        <nav class="bg-indigo-600 text-white p-4">
            <div class="flex justify-between items-center">
                <h1 class="text-xl font-bold">Dashboard Administrator</h1>
                <button onclick="logout()" class="bg-indigo-700 px-4 py-2 rounded-lg hover:bg-indigo-800">Keluar</button>
            </div>
        </nav>

        <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-2">Total Siswa</h3>
                    <p id="totalStudents" class="text-3xl font-bold text-indigo-600">0</p>
                </div>
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-2">Total Wali Kelas</h3>
                    <p id="totalTeachers" class="text-3xl font-bold text-green-600">0</p>
                </div>
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-2">Jurnal Hari Ini</h3>
                    <p id="todayJournals" class="text-3xl font-bold text-orange-600">0</p>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-semibold">Kelola Pengguna</h2>
                    <button onclick="showAddUserModal()" class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700">
                        Tambah Pengguna
                    </button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full table-auto">
                        <thead>
                            <tr class="bg-gray-50">
                                <th class="px-4 py-2 text-left">Username</th>
                                <th class="px-4 py-2 text-left">Nama</th>
                                <th class="px-4 py-2 text-left">Role</th>
                                <th class="px-4 py-2 text-left">Kelas</th>
                                <th class="px-4 py-2 text-left">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="userTable">
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold mb-4">Generate Laporan Jurnal</h2>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
                    <select id="reportPeriod" class="px-4 py-2 border border-gray-300 rounded-lg">
                        <option value="daily">Harian</option>
                        <option value="weekly">Mingguan</option>
                        <option value="monthly">Bulanan</option>
                        <option value="yearly">Tahunan</option>
                    </select>
                    <input type="date" id="reportDate" class="px-4 py-2 border border-gray-300 rounded-lg">
                    <select id="reportClass" class="px-4 py-2 border border-gray-300 rounded-lg">
                        <option value="">Semua Kelas</option>
                        <option value="1">Kelas 1</option>
                        <option value="2">Kelas 2</option>
                        <option value="3">Kelas 3</option>
                        <option value="4">Kelas 4</option>
                        <option value="5">Kelas 5</option>
                        <option value="6">Kelas 6</option>
                    </select>
                    <div class="flex space-x-2">
                        <button onclick="previewReport()" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition duration-200 font-medium">
                            👁️ Preview Laporan
                        </button>
                        <button onclick="generateReport()" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition duration-200 font-medium">
                            📊 Generate & Download Excel
                        </button>
                    </div>
                </div>

                <div class="mt-6">
                    <h3 class="text-lg font-semibold mb-3"> 📋 Laporan yang Telah Dibuat</h3>
                    <div id="reportsListView" class="space-y-2">
                        <div class="text-gray-500 text-center py-4">
                            Belum ada laporan yang dibuat. Klik “Generate Laporan” untuk membuat laporan baru.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="studentDashboard" class="hidden min-h-screen">
        <nav class="bg-indigo-600 text-white p-4">
            <div class="flex justify-between items-center">
                <h1 class="text-xl font-bold">Jurnal Kebiasaan</h1>
                <button onclick="logout()" class="bg-indigo-700 px-4 py-2 rounded-lg hover:bg-indigo-800">Keluar</button>
            </div>
        </nav>
        <div class="p-4">
            <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                <h2 class="text-xl font-semibold mb-4">Pilih Tanggal</h2>
                <div id="calendar" class="grid grid-cols-7 gap-2 text-center">
                    </div>
                <div class="mt-4 text-center">
                    <button onclick="prevMonth()" class="bg-gray-500 text-white px-4 py-2 rounded-lg mr-2">← Bulan Sebelumnya</button>
                    <span id="currentMonth" class="font-semibold mx-4"></span>
                    <button onclick="nextMonth()" class="bg-gray-500 text-white px-4 py-2 rounded-lg ml-2">Bulan Selanjutnya →</button>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-md p-6">
                <h2 class="text-xl font-semibold mb-4">Jurnal 7 Kebiasaan - <span id="selectedDateDisplay"></span></h2>
                <form id="journalForm" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="habit-card bg-gradient-to-r from-yellow-100 to-yellow-200 p-4 rounded-lg">
                            <label class="flex items-center space-x-3">
                                <input type="checkbox" name="habits" value="bangun_pagi" class="w-5 h-5 text-indigo-600">
                                <span class="font-medium"> 🌅 Bangun Pagi</span>
                            </label>
                        </div>
                        <div class="habit-card bg-gradient-to-r from-purple-100 to-purple-200 p-4 rounded-lg">
                            <label class="flex items-center space-x-3">
                                <input type="checkbox" name="habits" value="beribadah" class="w-5 h-5 text-indigo-600">
                                <span class="font-medium"> 🤲 Beribadah</span>
                            </label>
                        </div>
                        <div class="habit-card bg-gradient-to-r from-green-100 to-green-200 p-4 rounded-lg">
                            <label class="flex items-center space-x-3">
                                <input type="checkbox" name="habits" value="berolahraga" class="w-5 h-5 text-indigo-600">
                                <span class="font-medium"> 🏃‍♂️ Berolahraga</span>
                            </label>
                        </div>
                        <div class="habit-card bg-gradient-to-r from-red-100 to-red-200 p-4 rounded-lg">
                            <label class="flex items-center space-x-3">
                                <input type="checkbox" name="habits" value="makan_sehat" class="w-5 h-5 text-indigo-600">
                                <span class="font-medium"> 🥗 Makan Sehat dan Bergizi</span>
                            </label>
                        </div>
                        <div class="habit-card bg-gradient-to-r from-blue-100 to-blue-200 p-4 rounded-lg">
                            <label class="flex items-center space-x-3">
                                <input type="checkbox" name="habits" value="gemar_belajar" class="w-5 h-5 text-indigo-600">
                                <span class="font-medium"> 📚 Gemar Belajar</span>
                            </label>
                        </div>
                        <div class="habit-card bg-gradient-to-r from-orange-100 to-orange-200 p-4 rounded-lg">
                            <label class="flex items-center space-x-3">
                                <input type="checkbox" name="habits" value="bermasyarakat" class="w-5 h-5 text-indigo-600">
                                <span class="font-medium"> 🤝 Bermasyarakat</span>
                            </label>
                        </div>
                        <div class="habit-card bg-gradient-to-r from-indigo-100 to-indigo-200 p-4 rounded-lg">
                            <label class="flex items-center space-x-3">
                                <input type="checkbox" name="habits" value="tidur_cepat" class="w-5 h-5 text-indigo-600">
                                <span class="font-medium"> 😴 Tidur Cepat</span>
                            </label>
                        </div>
                    </div>
                    <div class="mt-6">
                        <button type="submit" class="w-full bg-indigo-600 text-white py-3 rounded-lg hover:bg-indigo-700 transition duration-200 font-medium">
                            Simpan Jurnal
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="teacherDashboard" class="hidden min-h-screen">
        <nav class="bg-indigo-600 text-white p-4">
            <div class="flex justify-between items-center">
                <h1 class="text-xl font-bold">Dashboard Wali Kelas</h1>
                <button onclick="logout()" class="bg-indigo-700 px-4 py-2 rounded-lg hover:bg-indigo-800">Keluar</button>
            </div>
        </nav>
        <div class="p-6">
            <div class="mb-6">
                <div class="flex space-x-4">
                    <button onclick="showTeacherTab('input')" id="inputTab" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
                        Input Jurnal Siswa
                    </button>
                    <button onclick="showTeacherTab('report')" id="reportTab" class="px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600">
                        Laporan Kelas
                    </button>
                </div>
            </div>

            <div id="teacherInputTab" class="space-y-6">
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h2 class="text-xl font-semibold mb-4">Pilih Siswa dan Tanggal</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Pilih Siswa</label>
                            <select id="studentSelect" class="w-full px-4 py-2 border border-gray-300 rounded-lg" onchange="loadStudentJournal()">
                                <option value="">-- Pilih Siswa --</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Tanggal</label>
                            <input type="date" id="teacherDateInput" class="w-full px-4 py-2 border border-gray-300 rounded-lg" onchange="loadStudentJournal()">
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md p-6">
                    <h2 class="text-xl font-semibold mb-4">Input Jurnal Siswa</h2>
                    <div id="teacherJournalSection" class="hidden">
                        <p class="mb-4 text-gray-600">Siswa: <span id="selectedStudentName" class="font-semibold"></span> | Tanggal: <span id="selectedJournalDate" class="font-semibold"></span></p>
                        <form id="teacherJournalForm" class="space-y-4">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="habit-card bg-gradient-to-r from-yellow-100 to-yellow-200 p-4 rounded-lg">
                                    <label class="flex items-center space-x-3">
                                        <input type="checkbox" name="teacherHabits" value="bangun_pagi" class="w-5 h-5 text-indigo-600">
                                        <span class="font-medium"> 🌅 Bangun Pagi</span>
                                    </label>
                                </div>
                                <div class="habit-card bg-gradient-to-r from-purple-100 to-purple-200 p-4 rounded-lg">
                                    <label class="flex items-center space-x-3">
                                        <input type="checkbox" name="teacherHabits" value="beribadah" class="w-5 h-5 text-indigo-600">
                                        <span class="font-medium"> 🤲 Beribadah</span>
                                    </label>
                                </div>
                                <div class="habit-card bg-gradient-to-r from-green-100 to-green-200 p-4 rounded-lg">
                                    <label class="flex items-center space-x-3">
                                        <input type="checkbox" name="teacherHabits" value="berolahraga" class="w-5 h-5 text-indigo-600">
                                        <span class="font-medium"> 🏃‍♂️ Berolahraga</span>
                                    </label>
                                </div>
                                <div class="habit-card bg-gradient-to-r from-red-100 to-red-200 p-4 rounded-lg">
                                    <label class="flex items-center space-x-3">
                                        <input type="checkbox" name="teacherHabits" value="makan_sehat" class="w-5 h-5 text-indigo-600">
                                        <span class="font-medium"> 🥗 Makan Sehat dan Bergizi</span>
                                    </label>
                                </div>
                                <div class="habit-card bg-gradient-to-r from-blue-100 to-blue-200 p-4 rounded-lg">
                                    <label class="flex items-center space-x-3">
                                        <input type="checkbox" name="teacherHabits" value="gemar_belajar" class="w-5 h-5 text-indigo-600">
                                        <span class="font-medium"> 📚 Gemar Belajar</span>
                                    </label>
                                </div>
                                <div class="habit-card bg-gradient-to-r from-orange-100 to-orange-200 p-4 rounded-lg">
                                    <label class="flex items-center space-x-3">
                                        <input type="checkbox" name="teacherHabits" value="bermasyarakat" class="w-5 h-5 text-indigo-600">
                                        <span class="font-medium"> 🤝 Bermasyarakat</span>
                                    </label>
                                </div>
                                <div class="habit-card bg-gradient-to-r from-indigo-100 to-indigo-200 p-4 rounded-lg">
                                    <label class="flex items-center space-x-3">
                                        <input type="checkbox" name="teacherHabits" value="tidur_cepat" class="w-5 h-5 text-indigo-600">
                                        <span class="font-medium"> 😴 Tidur Cepat</span>
                                    </label>
                                </div>
                            </div>
                            <div class="mt-6">
                                <button type="submit" class="w-full bg-indigo-600 text-white py-3 rounded-lg hover:bg-indigo-700 transition duration-200 font-medium">
                                    Simpan Jurnal Siswa
                                </button>
                            </div>
                        </form>
                    </div>
                    <div id="noStudentSelected" class="text-center text-gray-500 py-8">
                        Silakan pilih siswa dan tanggal untuk mulai input jurnal
                    </div>
                </div>
            </div>

            <div id="teacherReportTab" class="hidden">
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h2 class="text-xl font-semibold mb-4">Laporan Jurnal Kelas <span id="teacherClassName"></span></h2>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                        <select id="teacherReportPeriod" class="px-4 py-2 border border-gray-300 rounded-lg">
                            <option value="daily">Harian</option>
                            <option value="weekly">Mingguan</option>
                            <option value="monthly">Bulanan</option>
                            <option value="yearly">Tahunan</option>
                        </select>
                        <input type="date" id="teacherReportDate" class="px-4 py-2 border border-gray-300 rounded-lg">
                        <div class="flex space-x-2">
                            <button onclick="previewTeacherReport()" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition duration-200 font-medium">
                                👁️ Preview Laporan
                            </button>
                            <button onclick="generateTeacherReport()" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition duration-200 font-medium">
                                📊 Generate & Download Excel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="reportPreviewModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-lg w-full max-w-6xl max-h-[90vh] overflow-hidden">
            <div class="bg-indigo-600 text-white p-4 flex justify-between items-center">
                <h2 class="text-xl font-semibold"> 👁️ Preview Laporan Jurnal</h2>
                <button onclick="closeReportPreview()" class="text-white hover:text-gray-200 text-2xl font-bold">×</button>
            </div>

            <div class="p-6 overflow-y-auto max-h-[calc(90vh-80px)]">
                <div id="previewHeader" class="mb-6 text-center border-b pb-4">
                    <h1 class="text-2xl font-bold text-indigo-600 mb-2"> 📚 JURNAL 7 KEBIASAAN ANAK INDONESIA HEBAT</h1>
                    <p class="text-gray-600">SD N CIKUDA 03</p>
                </div>

                <div id="previewInfo" class="bg-gray-50 rounded-lg p-4 mb-6">
                    <h3 class="font-semibold text-lg mb-3"> 📋 Informasi Laporan</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                        <div><strong>Periode:</strong> <span id="previewPeriod">-</span></div>
                        <div><strong>Tanggal:</strong> <span id="previewDate">-</span></div>
                        <div><strong>Kelas:</strong> <span id="previewClass">-</span></div>
                        <div><strong>Total Entri:</strong> <span id="previewTotal">-</span></div>
                    </div>
                </div>

                <div id="previewSummary" class="bg-blue-50 rounded-lg p-4 mb-6">
                    <h3 class="font-semibold text-lg mb-3"> 📊 Ringkasan Statistik</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="text-center">
                            <div class="text-2xl font-bold text-blue-600" id="previewAvgPercentage">0%</div>
                            <div class="text-sm text-gray-600">Rata-rata Pencapaian</div>
                        </div>
                        <div class="text-center">
                            <div class="text-2xl font-bold text-green-600" id="previewActiveStudents">0</div>
                            <div class="text-sm text-gray-600">Siswa Aktif</div>
                        </div>
                        <div class="text-center">
                            <div class="text-2xl font-bold text-orange-600" id="previewPerformanceLevel">-</div>
                            <div class="text-sm text-gray-600">Kategori Pencapaian</div>
                        </div>
                    </div>
                </div>

                <div id="previewHabitsAnalysis" class="bg-green-50 rounded-lg p-4 mb-6">
                    <h3 class="font-semibold text-lg mb-3"> 🎯 Analisis Per Kebiasaan</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full table-auto text-sm">
                            <thead>
                                <tr class="bg-green-100">
                                    <th class="px-3 py-2 text-left">Kebiasaan</th>
                                    <th class="px-3 py-2 text-center">Jumlah</th>
                                    <th class="px-3 py-2 text-center">Persentase</th>
                                    <th class="px-3 py-2 text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody id="previewHabitsTable">
                            </tbody>
                        </table>
                    </div>
                </div>

                <div id="previewDataTable" class="bg-white border rounded-lg">
                    <h3 class="font-semibold text-lg p-4 bg-gray-100 rounded-t-lg"> 📝 Data Jurnal Siswa</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full table-auto text-sm">
                            <thead>
                                <tr class="bg-gray-50">
                                    <th class="px-3 py-2 text-left">No</th>
                                    <th class="px-3 py-2 text-left">Nama Siswa</th>
                                    <th class="px-3 py-2 text-left">Kelas</th>
                                    <th class="px-3 py-2 text-left">Tanggal</th>
                                    <th class="px-3 py-2 text-center"> 🌅 </th>
                                    <th class="px-3 py-2 text-center"> 🤲 </th>
                                    <th class="px-3 py-2 text-center"> 🏃‍♂️</th>
                                    <th class="px-3 py-2 text-center"> 🥗 </th>
                                    <th class="px-3 py-2 text-center"> 📚 </th>
                                    <th class="px-3 py-2 text-center"> 🤝 </th>
                                    <th class="px-3 py-2 text-center"> 😴 </th>
                                    <th class="px-3 py-2 text-center">Total</th>
                                    <th class="px-3 py-2 text-center">%</th>
                                </tr>
                            </thead>
                            <tbody id="previewDataTableBody">
                            </tbody>
                        </table>
                    </div>
                </div>

                <div id="previewNoData" class="hidden text-center py-8">
                    <div class="text-6xl mb-4"> 📋 </div>
